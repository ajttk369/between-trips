HOST=0.0.0.0
PORT=4310
# supabase: Supabase Auth 및 클라우드 저장. sqlite: 독립된 로컬 계정과 저장소.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
# 서버 전용. 브라우저/채팅에 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 공유 서버 운영 시 HTTPS 프록시 뒤에서 사용하세요.
COOKIE_SECURE=false
# 선택: Geoapify 장소 검색 및 도보·자동차 경로. 키가 없어도 직접 등록·지도·직선거리는 작동합니다.
GEOAPIFY_API_KEY=
# HTTPS 배포 주소 (초대 링크의 기준 주소)
PUBLIC_URL=
