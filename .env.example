HOST=0.0.0.0
PORT=4310
# supabase: Supabase Auth 및 클라우드 저장. sqlite: 독립된 로컬 계정과 저장소.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
# 서버 전용. 브라우저/채팅에 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 공유 서버 운영 시 HTTPS 프록시 뒤에서 사용하세요.
COOKIE_SECURE=false
# 선택: Geoapify 장소 검색 및 도보·자동차 경로. 키가 없어도 직접 등록·지도·직선거리는 작동합니다.
GEOAPIFY_API_KEY=
# 선택: Google 지도 + Places 검색. Maps JavaScript API, Places API (New) 활성화.
# 브라우저에서 사용하는 키이므로 Google Cloud의 웹사이트·API 제한이 필수입니다.
# 설정하면 Google 지도를 사용하고, 비워두면 기존 OpenStreetMap을 사용합니다.
GOOGLE_MAPS_API_KEY=
# HTTPS 배포 주소 (초대 링크의 기준 주소)
PUBLIC_URL=
# 선택: AI 여행 도우미. 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# Supabase SQL Editor에서 supabase/ai.sql도 한 번 실행해야 합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 한국 시각 하루 기준: 프로젝트 전체 / 계정별 추천 요청 제한
AI_DAILY_LIMIT=30
AI_USER_DAILY_LIMIT=10
